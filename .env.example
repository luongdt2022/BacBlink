# Sao chép file này thành .env và thay các giá trị mẫu trước khi chạy docker compose.
# Gmail yêu cầu xác minh 2 bước và App Password 16 ký tự; không dùng mật khẩu đăng nhập.
AUTH_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# SMTP Gmail
MAIL_DRY_RUN=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_STARTTLS=true
MAIL_USE_SSL=false
MAIL_USER=your-sender@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=your-sender@gmail.com
MAIL_FROM_NAME=NacenTech
