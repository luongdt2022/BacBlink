import { describe, it, expect, vi, beforeEach } from "vitest";
import { POST } from "./route";
import { NextRequest } from "next/server";

describe("CV Parser API Route (/api/cv-parser)", () => {
  beforeEach(() => {
    process.env.GEMINI_API_KEY = "dummy-test-token";
  });

  it("returns 400 when neither fileBase64 nor textContent is provided", async () => {
    const req = new NextRequest("http://localhost:3000/api/cv-parser", {
      method: "POST",
      body: JSON.stringify({}),
    });

    const res = await POST(req);
    expect(res.status).toBe(400);
    const data = await res.json();
    expect(data.success).toBe(false);
    expect(data.error).toContain("fileBase64 hoặc textContent");
  });

  it("handles successful parsing with mocked Gemini response", async () => {
    const mockGeminiResponse = {
      candidates: [
        {
          content: {
            parts: [
              {
                text: JSON.stringify({
                  fullName: "Nguyễn Văn Đức",
                  academicDegree: "TS",
                  primaryInstitution: "Viện NacenTech",
                  workAddress: "Hà Nội",
                  yearsOfExperience: 10,
                  primaryDomain: "Tự động hóa",
                  publications: [],
                  patents: [],
                }),
              },
            ],
          },
        },
      ],
    };

    const originalFetch = global.fetch;
    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      status: 200,
      json: async () => mockGeminiResponse,
      text: async () => JSON.stringify(mockGeminiResponse),
    } as unknown as Response);

    try {
      const req = new NextRequest("http://localhost:3000/api/cv-parser", {
        method: "POST",
        body: JSON.stringify({
          textContent: "TS. Nguyễn Văn Đức, Viện NacenTech, 10 năm kinh nghiệm Tự động hóa",
        }),
      });

      const res = await POST(req);
      expect(res.status).toBe(200);
      const data = await res.json();
      expect(data.success).toBe(true);
      expect(data.data.fullName).toBe("Nguyễn Văn Đức");
      expect(data.data.academicDegree).toBe("TS");
    } finally {
      global.fetch = originalFetch;
    }
  });
});
