<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kích hoạt tài khoản DMST</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f3f6fb;
      font-family: Inter, Arial, sans-serif;
      color: #0f172a;
    "
  >
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="padding: 24px 12px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
            "
          >
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0f172a, #1e293b);
                  padding: 20px 24px;
                  color: #ffffff;
                "
              >
                <h1
                  style="
                    margin: 0;
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 0.2px;
                  "
                >
                  Hệ thống DMST
                </h1>
                <p style="margin: 8px 0 0; font-size: 13px; color: #cbd5e1">
                  Xác nhận tài khoản người dùng
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding: 28px 24px 12px">
                <p style="margin: 0 0 12px; font-size: 16px; font-weight: 600">
                  Xin chào {{firstName}},
                </p>
                <p style="margin: 0 0 14px; font-size: 14px; line-height: 1.7; color: #334155">
                  Cảm ơn bạn đã đăng ký tài khoản trên hệ thống DMST. Để hoàn tất quá
                  trình đăng ký, vui lòng xác nhận email bằng cách nhấn nút bên dưới.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 8px 24px 20px">
                <a
                  href="{{activationLink}}"
                  style="
                    display: inline-block;
                    background: #0f172a;
                    color: #ffffff;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 600;
                    padding: 12px 24px;
                    border-radius: 10px;
                  "
                >
                  Kích hoạt tài khoản
                </a>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 24px 20px">
                <div
                  style="
                    background: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    padding: 12px;
                  "
                >
                  <p
                    style="
                      margin: 0 0 8px;
                      font-size: 12px;
                      color: #64748b;
                      font-weight: 600;
                    "
                  >
                    Nếu nút không hoạt động, hãy sao chép liên kết sau:
                  </p>
                  <p style="margin: 0; word-break: break-all; font-size: 12px; color: #0f172a">
                    {{activationLink}}
                  </p>
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 24px 24px">
                <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #64748b">
                  Nếu bạn không thực hiện đăng ký này, vui lòng bỏ qua email. Tài
                  khoản sẽ không được kích hoạt nếu chưa xác nhận.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  border-top: 1px solid #e2e8f0;
                  padding: 14px 24px;
                  font-size: 11px;
                  color: #94a3b8;
                  text-align: center;
                "
              >
                Email được gửi tự động, vui lòng không trả lời email này.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
