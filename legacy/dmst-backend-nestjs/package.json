{
  "name": "dmst-poc-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts src/database/migrations/$npm_config_name",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:rollback": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "seed:all": "ts-node -r tsconfig-paths/register src/database/scripts/seed-all.ts",
    "seed:intakes-chunks": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes-chunks.ts",
    "reindex:pg": "ts-node -r tsconfig-paths/register src/database/scripts/reindex-pg.ts",
    "seed:intakes": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes/run-all.ts",
    "seed:intakes:cntt": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes/01-cong-nghe-thong-tin.ts",
    "seed:intakes:yte": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes/02-y-te.ts",
    "seed:intakes:duoc": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes/03-duoc-pham.ts",
    "seed:intakes:challenges": "ts-node -r tsconfig-paths/register src/database/scripts/seed-intakes/04-challenges.ts",
    "backfill:matches": "ts-node -r tsconfig-paths/register src/database/scripts/backfill-matches.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d ./dist/database/data-source.js",
    "migration:run:prod": "npm run typeorm:prod -- migration:run",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "verify:single-embed": "ts-node -r tsconfig-paths/register src/database/scripts/verify-single-embed.ts"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.4.1",
    "file-type": "^22.0.0",
    "handlebars": "^4.7.9",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.9.3",
    "nodemailer": "^8.0.2",
    "openai": "^6.32.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "\\.integration-spec\\.ts$"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
