NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
ENABLE_DOCUMENTATION=true
APP_URL=http://localhost:3000
# CORS (frontend origin, comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Proxy hop count used to resolve real client IP from forwarding headers
TRUST_PROXY=1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=24h

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=DMST System
FRONTEND_URL=http://localhost:5173
ACTIVATION_PATH=/activate-account
ACTIVATION_TOKEN_TTL_MINUTES=60
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
RESEND_RATE_LIMIT_MAX=3
RESEND_RATE_LIMIT_WINDOW_SECONDS=600

# AI
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# BGE-M3 Embedding service
BGE_M3_URL=http://localhost:8003

# Search runs inside PostgreSQL (pgvector + pg_trgm + FTS). No ES_URL any more.
