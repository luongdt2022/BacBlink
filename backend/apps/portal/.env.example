# Backend .NET (NacenTech V2). Cổng 5199 khi chạy tay theo README của backend, 5000 khi chạy qua docker compose.
# Giá trị cũ `http://localhost:3001` là cổng của NacenTwin/NestJS — hệ đã bị thay thế (B-14).
#
# Bỏ trống biến này thì client dùng chính origin đang phục vụ trang, tức là cần một proxy đứng trước —
# cùng hành vi với bảng quản trị. Trước đây nó rơi về localhost:3001 ngay trong mã và hỏng im lặng.
VITE_API_BASE_URL=http://localhost:5199
VITE_API_PREFIX=api
VITE_API_VERSION=v1
